{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cardume",
  "version": "0.0.1",
  "identifier": "dev.cardume.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Cardume",
        "width": 1240,
        "height": 800,
        "minWidth": 920,
        "minHeight": 600,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "icon": ["icons/icon.png"]
  }
}
